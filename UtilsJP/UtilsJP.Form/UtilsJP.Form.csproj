<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>UtilsJP.Form</RootNamespace>
		<Authors>Yuriy Pradius</Authors>
		<Company>Pradius</Company>
		<Product>Utils JP</Product>
		<Copyright>Copyright © Pradius Y.A (2023)</Copyright>
		<Version>6.0.0</Version>
		<AssemblyVersion>6.0.0.0</AssemblyVersion>
	</PropertyGroup>

  <ItemGroup>
    <Folder Include="Splash\" />
    <Folder Include="Donate\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <Import Project="..\UtilsJP.Shared\UtilsJP.Shared.projitems" Label="Shared" />

</Project>
